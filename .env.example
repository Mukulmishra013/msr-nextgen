# ==============================================================================
# MSR Next Gen - Environment Variables Blueprint
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WhatsApp Configuration (CRITICAL)
# TODO: Replace with real WhatsApp Business phone number (with country code, e.g., 919876543210)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# ------------------------------------------------------------------------------
# 2. Business Contact Email & Site Metadata
# TODO: Replace with production business email & target domain
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_EMAIL=contact@msrnextgen.com
NEXT_PUBLIC_SITE_URL=https://msrnextgen.com

# ------------------------------------------------------------------------------
# 3. Cloudinary (Image & Video Delivery)
# TODO: Add your Cloudinary cloud name & unsigned upload preset
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=msr_unsigned_preset
# Server-side only (optional for future signed uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. Firebase (Lead Capture via Firestore)
# TODO: Add Firebase client & admin credentials
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server-side service account JSON (Base64 encoded or stringified JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 5. Optional Serverless Distributed Rate Limiting (Upstash Redis)
# Uncomment when scaling to serverless edge
# ------------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
